generator client {
  provider = "prisma-client-js"
  output   = "../packages/server/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 应用表 - 核心，先创建应用
model App {
  id           String          @id @default(uuid())
  name         String          // 应用名称
  packageName  String          // 包名
  iconPath     String?         // 图标路径
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  // 关联
  storeAccounts StoreAccount[] // 该应用在各商店的配置
  releases      ReleaseRecord[] // 发布记录
}

// 应用商店账号配置表 - 一个应用可以有多个商店配置
model StoreAccount {
  id          String   @id @default(uuid())
  
  // 关联应用
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  
  // 商店类型
  storeType   String   // xiaomi, huawei, oppo, vivo, honor, appgallery
  storeName   String   // 显示名称：小米、华为、OPPO、vivo、荣耀、应用宝
  
  // 账号凭证 - 小米
  email       String?  // 开发者邮箱（小米使用）
  privateKey  String?  // RSA私钥/访问密码（小米使用）
  publicKey   String?  // RSA公钥（小米使用）
  
  // 账号凭证 - 应用宝
  userId       String?  // 开发者用户ID（应用宝使用）
  yybAppId     String?  // 应用ID（应用宝使用）
  accessSecret String?  // 接入密钥（应用宝使用）
  
  // 应用商店特定配置
  categoryId   String?  // 分类ID
  categoryName String?  // 分类名称
  keywords     String?  // 关键词
  desc         String?  // 应用详情
  brief        String?  // 一句话简介
  updateDesc   String?  // 更新说明
  privacyUrl   String?  // 隐私政策链接
  feature      String?  // 版本特性说明（应用宝使用）
  
  // APK文件（每个商店可以有不同的APK）
  apkPath      String?  // APK路径
  versionName  String?  // 当前上传的版本名
  versionCode  String?  // 当前上传的版本号
  
  // 商店线上版本（从商店API查询）
  storeVersionName String?  // 商店线上版本名
  
  // 状态
  isActive     Boolean  @default(true)  // 是否启用
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  releases     ReleaseRecord[]
  
  @@unique([appId, storeType])  // 一个应用每个商店只能有一个配置
}

// 发布记录表
model ReleaseRecord {
  id          String   @id @default(uuid())
  
  // 关联应用
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  
  // 关联商店配置
  storeAccountId String
  storeAccount   StoreAccount @relation(fields: [storeAccountId], references: [id], onDelete: Cascade)
  
  storeType   String   // 商店类型
  versionName String   // 版本名称
  versionCode String   // 版本号
  status      String   @default("pending")  // pending/success/failed
  message     String?  // 返回信息
  
  createdAt   DateTime @default(now())
}
